# Postgres. Em desenvolvimento local: container Postgres 16 (ver README).
# Em produção (Neon): DATABASE_URL = connection string POOLED (runtime);
# DIRECT_URL = connection string DIRETA (só migrações).
DATABASE_URL="postgresql://casa:casa@localhost:5440/casa_magistral"
DIRECT_URL="postgresql://casa:casa@localhost:5440/casa_magistral"

# Auth.js — gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="troque-por-um-valor-aleatorio"

# AUTH_URL: defina SÓ no .env local. NÃO configure essa variável na Vercel:
# se ela existir lá, o Auth.js usa o valor fixo em vez de detectar o domínio
# real e todo redirecionamento passa a apontar para o localhost.
AUTH_URL="http://localhost:3050"

# Opcional: liga a rota POST /api/revalidar, que invalida o cache do catálogo (webhook de outro
# sistema). Sem esta variável a rota responde 404. Use um valor longo e aleatório.
# REVALIDATE_SECRET=""

# NÃO defina LIMITES_RELAXADOS fora da suíte de testes (playwright.config.ts): ele afrouxa o
# limite de tentativas de login, cadastro e compra.

# Usuários criados por `npm run db:seed` (valores de DESENVOLVIMENTO; o seed
# se recusa a usá-los em produção). Troque as senhas antes de qualquer deploy.
ADMIN_SEED_EMAIL="admin@casamagistral.exemplo"
ADMIN_SEED_PASSWORD="dev-admin-2026"
FARMACEUTICO_SEED_EMAIL="farmaceutica@casamagistral.exemplo"
FARMACEUTICO_SEED_PASSWORD="dev-farma-2026"
CLIENTE_SEED_EMAIL="cliente@casamagistral.exemplo"
CLIENTE_SEED_PASSWORD="dev-cliente-2026"
